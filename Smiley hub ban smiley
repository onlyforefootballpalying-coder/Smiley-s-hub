--           AUTO BLOCK CORE ENGINE
-- ==========================================
local function getBlockRemote()
    local names = {"Block", "BlockRemote", "HitBlock", "Defense"}
    for _, name in pairs(names) do
        local found = ReplicatedStorage:FindFirstChild(name)
        if found and found:IsA("RemoteEvent") then return found end
    end
    local folder = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("Events")
    if folder then
        for _, name in pairs(names) do
            local found = folder:FindFirstChild(name)
            if found and found:IsA("RemoteEvent") then return found end
        end
    end
    return nil
end

local blockRemote = getBlockRemote()

RunService.RenderStepped:Connect(function()
    if not _G.AutoBlockEnabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    if not blockRemote then blockRemote = getBlockRemote() end
    
    for _, enemy in pairs(Players:GetPlayers()) do
        if enemy ~= LocalPlayer and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
            local enemyChar = enemy.Character
            local enemyRoot = enemyChar.HumanoidRootPart
            local distance = (myRoot.Position - enemyRoot.Position).Magnitude
            
            if distance <= 15 then
                local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")
                local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
                
                if animator then
                    for _, anim in pairs(animator:GetPlayingAnimationTracks()) do
                        local name = string.lower(anim.Name)
                        
                        -- Detect M1, M2, Heavy Attacks and Slashes
                        if string.find(name, "attack") or string.find(name, "m1") or string.find(name, "m2") or string.find(name, "heavy") or string.find(name, "slash") then
                            if blockRemote then
                                if string.find(name, "m2") or string.find(name, "heavy") then
                                    -- Frame timing alignment for 100% Perfect Counter
                                    task.wait(0.01)
                                    blockRemote:FireServer(true)
                                    task.wait(0.2)
                                    blockRemote:FireServer(false)
                                else
                                    -- Instant Block for M1
                                    blockRemote:FireServer(true)
                                end
                            end
                            return
                        end
                    end
                end
            end
        end
    end
    
    -- Release blocking stance when no active danger
    if blockRemote then
        blockRemote:FireServer(false)
    end
end)

