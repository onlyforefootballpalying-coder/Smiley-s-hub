-- UI Library (Lightweight & Delta Compatible)
local Kavo = loadstring(game:HttpGet("https://githubusercontent.com"))()
local Window = Kavo.CreateLib("Smiley's Hub | Burning Ashes", "DarkTheme")

-- Variables
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

getgenv().AutoBlock = false
getgenv().PerfectM2Block = false

-- Tabs
local MainTab = Window:NewTab("Combat")
local CombatSection = MainTab:NewSection("Auto Block Features")

-- UI Elements
CombatSection:NewToggle("Enable Auto Block", "Automatically blocks incoming M1/M2 attacks", function(state)
    getgenv().AutoBlock = state
end)

CombatSection:NewToggle("100% M2 Perfect Counter", "Flawless timing for M2/Heavy attacks", function(state)
    getgenv().PerfectM2Block = state
end)

-- Universal Block Trigger Function
local function triggerBlock(isBlocking)
    -- Searches dynamically for game block remotes
    local remotes = {
        ReplicatedStorage:FindFirstChild("Block"),
        ReplicatedStorage:FindFirstChild("BlockRemote"),
        ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Block"),
        ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Block")
    }
    
    for _, remote in pairs(remotes) do
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(isBlocking)
        end
    end
end

-- Bypass/Optimization Loop
RunService.Heartbeat:Connect(function()
    if not getgenv().AutoBlock then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local enemyChar = player.Character
            local enemyRoot = enemyChar.HumanoidRootPart
            local distance = (myRoot.Position - enemyRoot.Position).Magnitude
            
            -- Combat range check (M1/M2 distance)
            if distance <= 16 then
                local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")
                local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
                
                if animator then
                    for _, anim in pairs(animator:GetPlayingAnimationTracks()) do
                        local animName = string.lower(anim.Name)
                        
                        -- Detect any attack pattern
                        if string.find(animName, "attack") or string.find(animName, "m1") or string.find(animName, "m2") or string.find(animName, "heavy") or string.find(animName, "slash") then
                            
                            if getgenv().PerfectM2Block and (string.find(animName, "m2") or string.find(animName, "heavy")) then
                                -- M2 Perfect Counter frame sync
                                task.wait(0.02)
                                triggerBlock(true)
                                task.wait(0.18)
                                triggerBlock(false)
                            else
                                -- Instant M1 Block
                                triggerBlock(true)
                            end
                            return
                        end
                    end
                end
            end
        end
    end
    -- Safety release when no threat is near
    triggerBlock(false)
end)
