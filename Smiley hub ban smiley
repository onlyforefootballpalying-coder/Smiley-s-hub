-- Fire Remote to Block/Unblock
local function performBlockAction(state)
    local possibleRemotes = {
        ReplicatedStorage:FindFirstChild("Block"),
        ReplicatedStorage:FindFirstChild("BlockRemote"),
        ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Block"),
        ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("Block"),
        ReplicatedStorage:FindFirstChild("Combat") and ReplicatedStorage.Combat:FindFirstChild("Block")
    }
    
    for _, remote in pairs(possibleRemotes) do
        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(state)
        end
    end
end

