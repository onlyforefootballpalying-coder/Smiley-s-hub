local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Configuration
local Settings = {
    AutoBlock = false,
    BypassMode = true
}

-- [THE CORE ENGINE] - High Performance Auto Block
task.spawn(function()
    while true do
        if Settings.AutoBlock then
            -- Scan for the block event (Searching dynamically to ensure it works after updates)
            local blockEvent = game:GetService("ReplicatedStorage"):FindFirstChild("BlockEvent", true) or 
                               game:GetService("ReplicatedStorage"):FindFirstChild("Block", true)
            
            if blockEvent then
                -- Fire the server with the block signal
                blockEvent:FireServer(true)
                
                -- ANTI-KICK BYPASS: 
                -- Instead of a fixed wait, we use a randomized micro-delay.
                -- This prevents the "Remote Event Spam" detection.
                task.wait(math.random(0.02, 0.07))
            else
                -- If event isn't found, wait a bit longer before scanning again to save CPU
                task.wait(1)
            end
        else
            -- Sleep the thread when OFF to prevent lag
            task.wait(0.5)
        end
    end
end)

